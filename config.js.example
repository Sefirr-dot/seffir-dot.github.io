// Copia este archivo como config.js y rellena los valores (no hagas commit de config.js)
export const firebaseConfig = {
  apiKey:         "FIREBASE_API_KEY",
  authDomain:     "FIREBASE_AUTH_DOMAIN",
  databaseURL:    "FIREBASE_DATABASE_URL",
  projectId:      "FIREBASE_PROJECT_ID",
  storageBucket:  "FIREBASE_STORAGE_BUCKET",
};

// El "apiKey" web de Firebase NO es un secreto: solo identifica el proyecto.
// La seguridad real está en las reglas de Realtime Database + Storage, que
// restringen lectura/escritura a tu auth.uid (ver database.rules.json y
// storage.rules). El acceso se controla con login de Google, no con contraseña.
